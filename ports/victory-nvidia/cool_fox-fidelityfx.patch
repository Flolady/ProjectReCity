+/// Diagnostics: why a title resource has or has not a host copy (for a
+/// host library given it, `crate::external`).
+#[cfg(windows)]
+pub(crate) fn host_why(this: This) -> String {
+    if this.is_null() {
+        return "null".into();
+    }
+    if !is_resource(this) {
+        return "not a resource of this runtime".into();
+    }
+    let r = resource(this);
+    let d = &r.desc;
+    format!(
+        "dimension {} {}x{} format {} flags {:#x} levels {} refused {} made {}",
+        d.dimension,
+        d.width,
+        d.height,
+        d.format,
+        d.flags,
+        d.mip_levels,
+        r.host.refused.load(std::sync::atomic::Ordering::Relaxed),
+        r.host.made.lock().unwrap_or_else(|e| e.into_inner()).is_some()
+    )
+}
