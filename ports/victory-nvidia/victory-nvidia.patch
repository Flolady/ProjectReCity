+/// `v_cvt_f32_f64` (the title's wave sums taken in doubles,
+/// a water volumetrics compute program): a double from two root
+/// constants to the nearest float, against Rust's own `as f32` (ties to
+/// even, overflow to infinity). (Ported from ProjectReCity's branch.)
+#[test]
+fn a_double_converts_to_the_nearest_float() {
+    let words = [
+        0x7E00_1E00, // v_cvt_f32_f64 v0, s[0:1]
+        0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+        0x38 << 26 | 0x1C << 18,
+        0x80 << 24 | 2 << 16, // buffer_store_dword v0, off, s[8:11], 0
+    ];
+    let native = native_of(&words, false, 32);
+    let p = ir::build(&native.code, native.wave64, native.vgprs).expect("ir::build");
+    let shader = lowered(&native, &p, &HashSet::new()).expect("lower");
+    if let Ok(mut v) = validator::Validator::load(validator::Validator::default_path().as_deref()) {
+        let mut copy = shader.dxil.clone();
+        v.validate(&mut copy).expect("DXIL validation failed");
+    }
+    let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    let cases = [
+        1.0f64,
+        64.0,
+        -3.5,
+        0.1,
+        1.0 + f64::powi(2.0, -24),     // a tie: stays at 1.0 (even)
+        1.0 + 3.0 * f64::powi(2.0, -24), // a tie: up to 1 + 2^-22
+        3.402_823_5e38,
+        1e39,
+        f64::INFINITY,
+        -f64::INFINITY,
+        123_456.789_012_345,
+        f64::NAN,
+    ];
+    for x in cases {
+        let bits = x.to_bits();
+        let Some(got) = on_the_card(&shader, [bits as u32, (bits >> 32) as u32]) else { return };
+        let want = x as f32;
+        if want.is_nan() {
+            assert!(f32::from_bits(got).is_nan(), "{x}: got {got:#x}");
+        } else {
+            assert_eq!(got, want.to_bits(), "{x}: got {}", f32::from_bits(got));
+        }
+    }
+    eprintln!("ran on the hardware device: {} doubles", cases.len());
+}
