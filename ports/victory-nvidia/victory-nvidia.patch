+/// With a capture folder: bytes the GPU wrote put back into title memory (`Shadow::copy_back`),
+/// appended at once to `writebacks.txt` with the frame and whether the copy is a window
+/// outside buffers (memory shaders reach by raw address) or a buffer's.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn writeback(address: usize, len: usize, window: bool) {
+    title_write(if window { "window" } else { "buffer" }, address, len, 0);
+}
+
+/// Diagnostics: which physical memory (a section of xmem's and the offset in it) title memory
+/// `[at, at + len)` shows through the title's views: "-" for private memory, "holes" or
+/// "scattered" for a range several views (or none for a part) hold.
+#[cfg(feature = "diagnostics")]
+pub fn phys_of(at: usize, len: usize) -> String {
+    #[cfg(windows)]
+    {
+        match crate::inplace::cover(at, len) {
+            crate::inplace::Cover::None => "-".into(),
+            crate::inplace::Cover::Holes => "holes".into(),
+            crate::inplace::Cover::Scattered => "scattered".into(),
+            crate::inplace::Cover::Run(section, offset) => format!("{section:#x}:{offset:#x}"),
+        }
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (at, len);
+        "-".into()
+    }
+}
+
+/// Diagnostics: the runtime mapped a view of physical memory, to `writebacks.txt`.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn view_mapped(at: usize, len: usize, section: usize, offset: u64) {
+    title_write(&format!("view {section:#x}:{offset:#x}"), at, len, 0);
+}
+
+/// Ranges of title memory to look for pointers into ([`mark_asset`]).
+#[cfg(feature = "diagnostics")]
+static MARKED: std::sync::Mutex<Vec<(usize, usize)>> = std::sync::Mutex::new(Vec::new());
+
+/// Diagnostics: a block of title memory (an asset DirectStorage loaded, picked by
+/// `VICTORY_MARK_ASSET`) whose address is looked for in what the host writes into title memory.
+#[cfg(feature = "diagnostics")]
+pub fn mark_asset(start: usize, len: usize) {
+    MARKED.lock().unwrap_or_else(|e| e.into_inner()).push((start, len));
+    title_write("marked", start, len, 0);
+}
+
+/// Diagnostics: each aligned qword of `bytes` (about to be written at `at` in title memory) that
+/// points into a marked block, to `writebacks.txt`.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn scan_marked(kind: &str, at: usize, bytes: &[u8]) {
+    let marked = MARKED.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    if marked.is_empty() {
+        return;
+    }
+    let skip = (8 - at % 8) % 8;
+    let Some(aligned) = bytes.get(skip..) else {
+        return;
+    };
+    for (i, q) in aligned.chunks_exact(8).enumerate() {
+        let v = u64::from_le_bytes(q.try_into().unwrap_or_default()) as usize;
+        if let Some(&(start, _)) = marked.iter().find(|(s, n)| v >= *s && v < s + n) {
+            title_write(&format!("{kind}-points-at-marked+{:#x}", v - start), at + skip + i * 8, 8, v);
+        }
+    }
+}
+
+/// [`scan_marked`] over title memory as it is now (after a copy into it).
+#[cfg(feature = "diagnostics")]
+pub(crate) fn scan_marked_at(kind: &str, at: usize, len: usize) {
+    if MARKED.lock().unwrap_or_else(|e| e.into_inner()).is_empty() || len > 64 << 20 {
+        return;
+    }
+    let mut bytes = vec![0u8; len];
+    if crate::host::read_into(at as *const u8, &mut bytes) {
+        scan_marked(kind, at, &bytes);
+    }
+}
+
+/// With a capture folder: any write of the host into title memory (`kind`: "window"/"buffer" for
+/// the GPU's write-back, "copy" for a buffer copy run at submission, "memcopy" for
+/// `CopyMemoryToMemoryX`, "readback" for a texture read-back), with its source when it has one,
+/// appended at once to `writebacks.txt`.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn title_write(kind: &str, address: usize, len: usize, source: usize) {
+    use std::io::Write;
+    static FILE: std::sync::Mutex<Option<std::fs::File>> = std::sync::Mutex::new(None);
+    let Some(folder) = folder() else {
+        return;
+    };
+    let mut file = FILE.lock().unwrap_or_else(|e| e.into_inner());
+    if file.is_none() {
+        *file = std::fs::OpenOptions::new().create(true).append(true).open(folder.join("writebacks.txt")).ok();
+    }
+    if let Some(f) = file.as_mut() {
+        let frame = crate::queue::presented() + 1;
+        let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_micros());
+        let phys = phys_of(address, len);
+        let _ = writeln!(f, "frame {frame} {kind} {address:#x}+{len:#x} from {source:#x} t {t} phys {phys}");
+    }
+}
+
+/// With a capture folder: a dispatch of the ray-tracing structure builder, appended at once to
+/// `builder-ops.txt` with the frame (its root views' title addresses say where it writes; the
+/// file is whole even if the title crashes right after).
+#[cfg(feature = "diagnostics")]
+pub(crate) fn builder_op(what: impl FnOnce() -> String) {
+    use std::io::Write;
+    static FILE: std::sync::Mutex<Option<std::fs::File>> = std::sync::Mutex::new(None);
+    let Some(folder) = folder() else {
+        return;
+    };
+    let mut file = FILE.lock().unwrap_or_else(|e| e.into_inner());
+    if file.is_none() {
+        *file = std::fs::OpenOptions::new().create(true).append(true).open(folder.join("builder-ops.txt")).ok();
+    }
+    if let Some(f) = file.as_mut() {
+        let frame = crate::queue::presented() + 1;
+        let _ = writeln!(f, "frame {frame} {}", what());
+    }
+}
+
+/// Writes the last lines of [`op`] before the world to `name` in the capture folder (a host
+/// GPU failure before the world: what was recorded last).
+#[cfg(feature = "diagnostics")]
+pub(crate) fn write_ring(name: &str) {
+    if let Some(folder) = folder() {
+        let lines: Vec<String> = RING.lock().unwrap_or_else(|e| e.into_inner()).iter().cloned().collect();
+        if !lines.is_empty() {
+            let _ = std::fs::write(folder.join(name), lines.join("\n"));
+        }
+    }
+}
