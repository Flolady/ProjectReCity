+/// A lane count taken in doubles inside a whole-wave section, as
+/// a water volumetrics compute program counts its lanes: the lanes below s0
+/// hold 1.0 (high dword 0x3ff00000), summed with `v_add_f64` over DPP8 neighbours,
+/// `row_mirror` and `v_permlanex16`, read from lane 0 and converted to a float. A 32-lane
+/// console wave; every lane stores the float to dword 0. (Ported from ProjectReCity's
+/// branch.)
+#[test]
+fn a_lane_count_in_doubles_is_the_count() {
+    let pair = |w0: u32, w1: u32| [w0, w1];
+    let mut words = vec![
+        0x7E10_0280, // v_mov_b32 v8, 0
+        0x7E12_02FF,
+        0x3FF0_0000, // v_mov_b32 v9, 0x3ff00000 (1.0's high dword)
+        0x7D88_0000, // v_cmp_gt_u32 vcc_lo, s0, v0
+        0xBE94_036A, // s_mov_b32 s20, vcc_lo
+        0xBE90_3DC1, // s_or_saveexec_b32 s16, -1
+        0x7E04_0280, // v_mov_b32 v2, 0
+        0x7E06_0280, // v_mov_b32 v3, 0
+        0x870E_1014, // s_and_b32 s14, s20, s16
+        0xD501_0002,
+        0x003A_1102, // v_cndmask_b32 v2, v2, v8, s14
+        0xD501_0003,
+        0x003A_1303, // v_cndmask_b32 v3, v3, v9, s14
+    ];
+    for (lo, hi) in [
+        (0xDE54_C102, 0xDE54_C103), // dpp8:[1,0,3,2,5,4,7,6]
+        (0x9360_1202, 0x9360_1203), // dpp8:[2,2,0,0,6,6,4,4]
+        (0x0009_2402, 0x0009_2403), // dpp8:[4,4,4,4,0,0,0,0]
+    ] {
+        words.extend(pair(0x7E08_02E9, lo)); // v_mov_b32 v4, v2 dpp8
+        words.extend(pair(0x7E0A_02E9, hi)); // v_mov_b32 v5, v3 dpp8
+        words.extend(pair(0xD564_0002, 0x0002_0504)); // v_add_f64 v[2:3], v[4:5], v[2:3]
+    }
+    words.extend(pair(0x7E08_02FA, 0xFF09_4002)); // v_mov_b32 v4, v2 row_mirror bound_ctrl:1
+    words.extend(pair(0x7E0A_02FA, 0xFF09_4003)); // v_mov_b32 v5, v3 row_mirror bound_ctrl:1
+    words.extend(pair(0xD564_0002, 0x0002_0504)); // v_add_f64 v[2:3], v[4:5], v[2:3]
+    words.extend(pair(0xD778_0004, 0x0201_0102)); // v_permlanex16_b32 v4, v2, 0, 0
+    words.extend(pair(0xD778_0005, 0x0201_0103)); // v_permlanex16_b32 v5, v3, 0, 0
+    words.extend(pair(0xD564_0002, 0x0002_0504)); // v_add_f64 v[2:3], v[4:5], v[2:3]
+    words.extend(pair(0xD760_000C, 0x0001_0102)); // v_readlane_b32 s12, v2, 0
+    words.extend(pair(0xD760_000D, 0x0001_0103)); // v_readlane_b32 s13, v3, 0
+    words.extend([
+        0xBEFE_0310, // s_mov_b32 exec_lo, s16
+        0x7E14_1E0C, // v_cvt_f32_f64 v10, s[12:13]
+        0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+        0xE070_0000,
+        0x8002_0A00, // buffer_store_dword v10, off, s[8:11], 0
+    ]);
+    let native = native_of(&words, false, 32);
+    let p = ir::build(&native.code, native.wave64, native.vgprs).expect("ir::build");
+    let shader = lowered(&native, &p, &HashSet::new()).expect("lower");
+    if let Ok(mut v) = validator::Validator::load(validator::Validator::default_path().as_deref()) {
+        let mut copy = shader.dxil.clone();
+        v.validate(&mut copy).expect("DXIL validation failed");
+    }
+    let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    for below in [32u32, 10, 1, 0, 40] {
+        let Some(got) = on_the_card(&shader, [below, 0]) else { return };
+        let want = below.min(32) as f32;
+        assert_eq!(f32::from_bits(got), want, "{below} lanes below s0");
+    }
+    eprintln!("ran on the hardware device: lane counts in doubles");
+}
