+/// `v_permlanex16_b32` outside a whole-wave section (the title's upscaler and
+/// a water optical-depth compute program), on a
+/// 32-lane console wave: lanes below 24 run it; lane l reads v2 = 1000 +
+/// lane of lane ((l & 16) ^ 16) | nibble (l & 15) of {s7, s6}. A source lane
+/// left out gives the old v3 (0xdead), or 0 with bound_ctrl:1 (RDNA ISA).
+/// Every lane stores its v3. (Ported from ProjectReCity's VIctory branch.)
+#[test]
+fn permlanex16_reads_the_other_row_by_its_selector() {
+    const S6: u32 = 0x9E3B_1F05;
+    const S7: u32 = 0x4C8D_02A7;
+    let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    for bound_ctrl in [false, true] {
+        let words = [
+            0xBE86_03FF,
+            S6, // s_mov_b32 s6, S6
+            0xBE87_03FF,
+            S7, // s_mov_b32 s7, S7
+            0x4A04_00FF,
+            0x0000_03E8, // v_add_nc_u32 v2, 1000, v0
+            0x7E06_02FF,
+            0x0000_DEAD, // v_mov_b32 v3, 0xdead
+            0x3414_0082, // v_lshlrev_b32 v10, 2, v0
+            0x7D88_0098, // v_cmp_gt_u32 vcc_lo, 24, v0
+            0xBE94_3C6A, // s_and_saveexec_b32 s20, vcc_lo
+            // v_permlanex16_b32 v3, v2, s6, s7 [bound_ctrl:1]
+            0xD778_0003 | u32::from(bound_ctrl) << 12,
+            0x001C_0D02,
+            0xBEFE_0314, // s_mov_b32 exec_lo, s20
+            0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+            0xE070_1000,
+            0x8002_030A, // buffer_store_dword v3, v10, s[8:11], 0 offen
+        ];
+        let native = native_of(&words, false, 32);
+        let p = ir::build(&native.code, native.wave64, native.vgprs).expect("ir::build");
+        let shader = lowered(&native, &p, &HashSet::new()).expect("lower");
+        if let Ok(mut v) = validator::Validator::load(validator::Validator::default_path().as_deref()) {
+            let mut copy = shader.dxil.clone();
+            v.validate(&mut copy).expect("DXIL validation failed");
+        }
+        let sel = u64::from(S6) | u64::from(S7) << 32;
+        let want: Vec<u32> = (0..32u32)
+            .map(|l| {
+                let src = ((l & 16) ^ 16) | (sel >> (4 * (l & 15)) & 15) as u32;
+                match src {
+                    _ if l >= 24 => 0xDEAD,
+                    src if src < 24 => 1000 + src,
+                    _ if bound_ctrl => 0,
+                    _ => 0xDEAD,
+                }
+            })
+            .collect();
+        let Ok(host) = Host::new(false) else {
+            eprintln!("no SM 6.6 hardware device; not run");
+            return;
+        };
+        let Ok((root, pso)) = host.compute_pipeline(&shader) else {
+            eprintln!("the hardware device does not take this program; not run");
+            return;
+        };
+        let ud = vec![0u32; shader.user_data_dwords().max(1) as usize];
+        let out = host
+            .dispatch(
+                &root,
+                &pso,
+                &Dispatch {
+                    roots: vec![(0, Root::Constants(ud))],
+                    views: &[View::RawUav(32)],
+                    samplers: &[],
+                    groups: [1, 1, 1],
+                },
+            )
+            .unwrap_or_else(|e| panic!("dispatch failed: {e}"));
+        assert_eq!(out[0], want, "bound_ctrl {bound_ctrl}");
+        eprintln!("ran on the hardware device: bound_ctrl {bound_ctrl}");
+    }
+}
