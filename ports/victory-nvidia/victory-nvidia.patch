+/// The structure builder's sum of the totals of the waves before this one
+/// (`XboxBvhBuilder`, `v_readfirstlane` at 0x1d4), with 64-lane console waves on 32-lane host
+/// waves that exchange: each wave's lane 0 writes (wave + 1) to LDS; after a barrier, the lanes
+/// of wave w loop over the slots below w, carrying the running sum and reading it back with
+/// `v_readfirstlane` at the top of each round, where only the looping lanes run. Every lane in
+/// the loop holds the same sum, so the host wave's first lane answers for the console wave's.
+/// A `v_readlane` of lane 31 where every lane runs makes the halves exchange. Four console
+/// waves in a group of 256: sums 0, 1, 3, 6; lane 31's thread id 64 w + 31.
+#[test]
+fn a_first_lane_read_of_a_sum_every_looping_lane_holds() {
+    let words = [
+        0x2C0E_0086, // v_lshrrev_b32 v7, 6, v0
+        0xD760_0014,
+        0x0001_3F00, // v_readlane_b32 s20, v0, 31
+        0x3612_00BF, // v_and_b32 v9, 63, v0
+        0x4A14_0E81, // v_add_nc_u32 v10, 1, v7
+        0x3416_0E82, // v_lshlrev_b32 v11, 2, v7
+        0xBE80_047E, // s_mov_b64 s[0:1], exec
+        0x7DA4_1280, // v_cmpx_eq_u32 exec, 0, v9
+        0xD834_0000,
+        0x0000_0A0B, // ds_write_b32 v11, v10
+        0xBEFE_0400, // s_mov_b64 exec, s[0:1]
+        0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+        0xBF8A_0000, // s_barrier
+        0x7E10_0280, // v_mov_b32 v8, 0
+        0xBE80_047E, // s_mov_b64 s[0:1], exec
+        0x7DAA_0E80, // v_cmpx_ne_u32 exec, 0, v7
+        0xBF88_0011, // s_cbranch_execz END
+        0xBE86_047E, // s_mov_b64 s[6:7], exec
+        0xBE92_0380, // s_mov_b32 s18, 0
+        0xBE91_0380, // s_mov_b32 s17, 0
+        0xBF82_0002, // s_branch BODY
+        0x87FE_0610, // TOP: s_and_b64 exec, s[16:17], s[6:7]
+        0x7E22_0508, // v_readfirstlane_b32 s17, v8
+        0x8F10_8212, // BODY: s_lshl_b32 s16, s18, 2
+        0x8112_8112, // s_add_i32 s18, s18, 1
+        0x7E10_0210, // v_mov_b32 v8, s16
+        0xD8D8_0000,
+        0x0800_0008, // ds_read_b32 v8, v8
+        0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+        0x4A10_1011, // v_add_nc_u32 v8, s17, v8
+        0xBE90_047E, // s_mov_b64 s[16:17], exec
+        0x7DA4_0E12, // v_cmpx_eq_u32 exec, s18, v7
+        0x8A86_7E06, // s_andn2_b64 s[6:7], s[6:7], exec
+        0xBF85_FFF3, // s_cbranch_scc1 TOP
+        0xBEFE_0400, // END: s_mov_b64 exec, s[0:1]
+        0x3418_0082, // v_lshlrev_b32 v12, 2, v0
+        0x7E1C_0214, // v_mov_b32 v14, s20
+        0x4A1E_18FF,
+        0x0000_0400, // v_add_nc_u32 v15, 1024, v12
+        0xE070_1000,
+        0x8002_080C, // buffer_store_dword v8, v12, s[8:11], 0 offen
+        0xE070_1000,
+        0x8002_0E0F, // buffer_store_dword v14, v15, s[8:11], 0 offen
+    ];
+    let mut native = native_of(&words, true, 256);
+    // 512 bytes of LDS: the four waves' totals
+    native.io = StageIo::Cs(ComputeIo {
+        rsrc2: (5 << 1) | (1 << 15),
+        threads: [256, 1, 1],
+    });
+    let p = ir::build(&native.code, native.wave64, native.vgprs).expect("ir::build");
+    let shader = lowered(&native, &p, &HashSet::new()).expect("lower");
+    if let Ok(mut v) = validator::Validator::load(validator::Validator::default_path().as_deref()) {
+        let mut copy = shader.dxil.clone();
+        v.validate(&mut copy).expect("DXIL validation failed");
+    }
+    let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    let Ok(host) = Host::new(false) else {
+        eprintln!("no SM 6.6 hardware device; not run");
+        return;
+    };
+    let Ok((root, pso)) = host.compute_pipeline(&shader) else {
+        eprintln!("the hardware device does not take this program; not run");
+        return;
+    };
+    let ud = vec![0u32; shader.user_data_dwords().max(1) as usize];
+    let out = host
+        .dispatch(
+            &root,
+            &pso,
+            &Dispatch {
+                roots: vec![(0, Root::Constants(ud))],
+                views: &[View::RawUav(512)],
+                samplers: &[],
+                groups: [1, 1, 1],
+            },
+        )
+        .unwrap_or_else(|e| panic!("dispatch failed: {e}"));
+    let sums: Vec<u32> = (0..256u32).map(|t| [0, 1, 3, 6][(t >> 6) as usize]).collect();
+    let lane31: Vec<u32> = (0..256u32).map(|t| (t >> 6) * 64 + 31).collect();
+    assert_eq!(out[0][..256], sums[..], "sums of the waves before");
+    assert_eq!(out[0][256..512], lane31[..], "lane 31's thread id");
+    eprintln!("ran on the hardware device: the sums of the waves before, through v_readfirstlane");
+}
